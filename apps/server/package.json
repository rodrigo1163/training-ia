{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "auth:generate": "pnpm dlx auth@1.7.4 generate --config src/auth.ts --output src/db/schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "trigger:login": "trigger login",
    "trigger:dev": "trigger dev",
    "check:integrations": "tsx src/scripts/check-integrations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@fastify/cors": "^11.3.0",
    "@langchain/core": "^1.2.11",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@trigger.dev/sdk": "^4.6.1",
    "better-auth": "1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.6.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "trigger.dev": "^4.6.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
