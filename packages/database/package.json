{
  "name": "@training-ia/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./prisma/generated/prisma/client.ts",
      "import": "./dist/prisma/generated/prisma/client.js"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "import": "./dist/src/postgres.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "typescript": "^6.0.2"
  }
}
